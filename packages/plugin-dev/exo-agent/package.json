{
  "name": "exo-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Exo AI plugin for Super Productivity: streams work events to Flow OS and shows Exo AI plans and handed-off work",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src vite.config.ts --max-warnings 0 && prettier --check \"src/**/*.{ts,css,json}\" vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,css,json}\" vite.config.ts"
  },
  "devDependencies": {
    "@super-productivity/plugin-api": "file:../../plugin-api",
    "@super-productivity/vite-plugin": "file:../../vite-plugin",
    "@types/node": "^22.15.33",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  }
}
